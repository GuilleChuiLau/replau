ADAPTER_HOST=127.0.0.1
ADAPTER_PORT=8792

REQUIRE_HOOK_TOKEN=true
HOOK_TOKEN=RESTRICTED

OPENCLAW_BIN=openclaw
OPENCLAW_CHANNEL=whatsapp
OPENCLAW_ACCOUNT=

OPENCLAW_TIMEOUT=90
LOG_LEVEL=INFO

# Keep OpenClaw as the live transport until Meta credentials, approved templates,
# and account-quality review are complete.
WHATSAPP_TRANSPORT=openclaw

# Disabled unless WHATSAPP_TRANSPORT=meta_cloud_api.
META_GRAPH_API_BASE=https://graph.facebook.com
META_GRAPH_API_VERSION=v23.0
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_REQUEST_TIMEOUT=30
